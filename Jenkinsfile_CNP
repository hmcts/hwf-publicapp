#!groovy

@Library("Infrastructure@2.13.5")

def type = "ruby"
def product = "help-with-fees"
def component = "publicapp"

def rubyBuilder = new uk.gov.hmcts.contino.RubyBuilder(this)
def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

withPipeline(type, product, component) {
  env.RAILS_ENV = 'test'
  env.RACK_ENV = 'test'
  env.TEST_BROWSER = 'chrome_local'
  // Don't pin DRIVER: the suite defaults to the in-process rack_test driver
  // (fast, no browser). Scenarios tagged @javascript run under cuprite and
  // @zap scenarios under firefox via the ZAP proxy - see
  // features/support/capybara_driver_helper.rb and features/support/hooks.rb.
  env.NODE_OPTIONS='--openssl-legacy-provider'
  env.ENABLE_COVERAGE='true'
  // random free port should probably be used instead
  env.GOVUK_NOTIFY_API_KEY = 'mocked_in_tests'
  env.CUCUMBER_PUBLISH_ENABLED = 'true'


  def installRuby = {
    sh script:"""#!/bin/bash -l
      set +x
      source /usr/local/rvm/scripts/rvm
      rvm install ruby-4.0.9 --binary --autolibs=read-only
      rvm use ruby-4.0.9 --default
      """, label: 'Ruby version install'
  }

  // Propshaft serves only what is already in app/assets/builds (gitignored and
  // produced by the yarn build scripts), so every stage that boots the Rails app
  // in-process needs the node deps installed and the assets built. That is not
  // just the build stage: a re-run skips Build when the image already exists in
  // ACR, and the smoke/functional stages can land on a fresh agent.
  def installNodeAndAssets = {
    sh script:"""
      mkdir -p ~/.local/bin
      corepack enable --install-directory ~/.local/bin
      export PATH=~/.local/bin:\$PATH
      yarn install
    """, label: 'Install node dependencies'
    rubyBuilder.bundle("exec rails assets:precompile")
  }

  before('build') { installRuby() }
  // Smoke/functional tests run on a fresh agent, separate from the build, so
  // neither the Ruby install, the vendor/bundle gems nor the compiled assets
  // from the build stage are present there. Install all three, otherwise
  // `bundle exec` fails with "azure_env_secrets ... is not yet checked out"
  // and cucumber fails with "The asset 'application.css' was not found".
  def installRubyGemsAndAssets = {
    installRuby()
    rubyBuilder.bundle("config set path 'vendor/bundle'")
    rubyBuilder.bundle("install --jobs=4 --retry=3")
    installNodeAndAssets()
  }
  before('smoketest:preview') { installRubyGemsAndAssets() }
  before('smoketest:aat') { installRubyGemsAndAssets() }
  before('functionalTest:preview') { installRubyGemsAndAssets() }
  before('functionalTest:aat') { installRubyGemsAndAssets() }

   before('test') {
      sh script:"mkdir -p features/cucumber-report", label: 'Create report directory'
      sh script:"env AZURE_CONFIG_DIR=/opt/jenkins/.azure-nonprod az acr login --name hmctsprod --subscription DCD-CNP-PROD", label: 'ACR login'
      rubyBuilder.bundle("install")
      // Git-sourced gems leave read-only pack files in the bundler cache,
      // which breaks workspace unstash (tar can't overwrite them on re-extract)
      sh script: 'chmod -R u+w vendor/bundle || true', label: 'Make bundle cache writable for stash'
      installNodeAndAssets()

      sh script: 'docker run -d --name zap -p 8080:8080 ghcr.io/zaproxy/zaproxy zap.sh -daemon -host 0.0.0.0 -port 8080 -config api.disablekey=true', label: 'Start ZAP'
      sh script: 'sleep 15', label: 'Wait for ZAP to start'
      env.ZAP_SCAN = 'true'
      env.SE_MANAGER_OFFLINE = 'true'
  }

  afterAlways('test') {
      sh script: 'docker stop zap && docker rm zap || true', label: 'Stop ZAP'
  }

  afterAlways('functionalTest:preview') {
      junit testResults: 'tmp/test/cucumber-functional/*.xml', allowEmptyResults: true, skipPublishingChecks: false
  }
}
