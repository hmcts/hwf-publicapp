div.govuk-summary-list__row
  dt.govuk-summary-list__key
    span.govuk-error-message = t(label, scope: 'summary.labels')
  dd.govuk-summary-list__value
    span.govuk-error-message = t(answer, scope: 'summary.missing_answer')
  dd.govuk-summary-list__actions
    = link_to question_path(question), onclick: "dataLayer.push({'sectionName': '#{question}', 'event': 'summary_page'});" do
      = t('summary.change')
      span.govuk-visually-hidden
        = t(label, scope: 'summary.labels').downcase
